{
 "action": "disable_recording(living_room_camera)",
 "guards": [
  {
   "id": "G1",
   "field": "state.lease.issuer",
   "op": "eq",
   "value": "root_agent"
  },
  {
   "id": "G2",
   "field": "state.lease.grantee",
   "op": "eq_field",
   "other_field": "envelope.sender_id"
  },
  {
   "id": "G3",
   "field": "state.lease.scope",
   "op": "includes",
   "value": "disable_recording(living_room_camera)"
  },
  {
   "id": "G4",
   "field": "state.lease.base_commit",
   "op": "eq_field",
   "other_field": "state.current_commit"
  },
  {
   "id": "G5",
   "field": "state.presence_source",
   "op": "in",
   "values": [
    "phone",
    "button"
   ]
  },
  {
   "id": "G6",
   "field": "state.presence_observed_at",
   "op": "fresher_than",
   "duration_sec": 30
  },
  {
   "id": "G7",
   "field": "state.camera.privacy_request",
   "op": "includes",
   "value": "resident"
  }
 ],
 "deny": [
  {
   "id": "D1",
   "field": "state.deny_mode",
   "op": "in",
   "values": [
    "vacation",
    "lockdown",
    "away"
   ]
  },
  {
   "id": "D2",
   "field": "state.alarm.state",
   "op": "in",
   "values": [
    "triggered",
    "tamper"
   ]
  }
 ]
}