{
 "action": "siren_off(living_room)",
 "guards": [
  {
   "id": "G1",
   "field": "state.lease.issuer",
   "op": "eq",
   "value": "root_agent"
  },
  {
   "id": "G2",
   "field": "state.lease.grantee",
   "op": "eq_field",
   "other_field": "envelope.sender_id"
  },
  {
   "id": "G3",
   "field": "state.lease.scope",
   "op": "includes",
   "value": "siren_off(living_room)"
  },
  {
   "id": "G4",
   "field": "state.lease.base_commit",
   "op": "eq_field",
   "other_field": "state.current_commit"
  },
  {
   "id": "G5",
   "field": "state.alarm.ack_source",
   "op": "in",
   "values": [
    "button",
    "phone"
   ]
  },
  {
   "id": "G6",
   "field": "state.alarm.ack_observed_at",
   "op": "fresher_than",
   "duration_sec": 60
  },
  {
   "id": "G7",
   "field": "state.alarm.state",
   "op": "not_in",
   "values": [
    "triggered",
    "tamper"
   ]
  }
 ],
 "deny": [
  {
   "id": "D1",
   "field": "state.deny_mode",
   "op": "in",
   "values": [
    "lockdown"
   ]
  }
 ]
}